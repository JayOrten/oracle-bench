  "content": "\"\"\"Unit tests for the constructors in ``xarray/core/rolling.py``.\"\"\"\nfrom __future__ import annotations\n\nimport numpy as np\nimport pytest\n\nimport xarray as xr\nfrom xarray.core import duck_array_ops\nfrom xarray.core.rolling import (\n    DataArrayCoarsen,\n    DataArrayRolling,\n    DatasetCoarsen,\n    DatasetRolling,\n)\n\n\n@pytest.fixture\ndef da():\n    return xr.DataArray(\n        np.arange(12.0).reshape(3, 4),\n        dims=(\"x\", \"y\"),\n        coords={\"x\": [10, 20, 30], \"y\": [1, 2, 3, 4], \"lab\": (\"x\", [\"a\", \"b\", \"c\"])},\n        attrs={\"units\": \"m\"},\n    )\n\n\n@pytest.fixture\ndef ds(da):\n    return xr.Dataset(\n        {\n            \"a\": da,\n            \"b\": (\"y\", np.arange(4.0)),\n            \"c\": (\"x\", np.arange(3.0)),\n            \"d\": (\"z\", np.arange(2.0)),\n        },\n        coords=da.coords,\n    )\n\n\nclass TestRollingInit:\n    def test_basic_attributes(self, da):\n        r = DataArrayRolling(da, {\"y\": 3})\n        assert r.obj is da\n        assert r.dim == [\"y\"]\n        assert r.window == [3]\n        assert r.center == [False]\n        assert r.min_periods == 3\n        assert r.ndim == 1\n\n    def test_multiple_dims_preserve_order(self, da):\n        r = DataArrayRolling(da, {\"y\": 2, \"x\": 3})\n        assert r.dim == [\"y\", \"x\"]\n        assert r.window == [2, 3]\n        assert r.ndim == 2\n\n    def test_default_min_periods_is_product_of_windows(self, da):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 3})\n        assert r.min_periods == 6\n\n    @pytest.mark.parametrize(\"min_periods\", [1, 2, 100])\n    def test_explicit_min_periods(self, da, min_periods):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 3}, min_periods=min_periods)\n        assert r.min_periods == min_periods\n\n    @pytest.mark.parametrize(\"min_periods\", [0, -1])\n    def test_invalid_min_periods(self, da, min_periods):\n        with pytest.raises(ValueError, match=\"min_periods must be greater than zero\"):\n            DataArrayRolling(da, {\"y\": 2}, min_periods=min_periods)\n\n    @pytest.mark.parametrize(\"window\", [0, -2])\n    def test_invalid_window(self, da, window):\n        with pytest.raises(ValueError, match=\"window must be > 0\"):\n            DataArrayRolling(da, {\"y\": window})\n\n    def test_invalid_window_in_second_dim(self, da):\n        with pytest.raises(ValueError, match=\"window must be > 0\"):\n            DataArrayRolling(da, {\"x\": 2, \"y\": 0})\n\n    def test_invalid_window_checked_before_min_periods(self, da):\n        with pytest.raises(ValueError, match=\"window must be > 0\"):\n            DataArrayRolling(da, {\"y\": 0}, min_periods=0)\n\n    @pytest.mark.parametrize(\"center\", [True, False])\n    def test_scalar_center_broadcast(self, da, center):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 2}, center=center)\n        assert r.center == [center, center]\n\n    def test_mapping_center(self, da):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 2}, center={\"y\": True})\n        assert r.center == [False, True]\n\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 2}, center={\"x\": True, \"y\": False})\n        assert r.center == [True, False]\n\n    def test_mapping_center_ignores_unknown_keys(self, da):\n        r = DataArrayRolling(da, {\"y\": 2}, center={\"x\": True, \"other\": True})\n        assert r.center == [False]\n\n    def test_repr(self, da):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 3}, center={\"y\": True})\n        assert repr(r) == \"DataArrayRolling [x->2,y->3(center)]\"\n\n    def test_len(self, da):\n        assert len(DataArrayRolling(da, {\"y\": 2})) == 4\n        assert len(DataArrayRolling(da, {\"x\": 2, \"y\": 2})) == 12\n\n\nclass TestDataArrayRollingInit:\n    def test_window_labels_with_coordinate(self, da):\n        r = DataArrayRolling(da, {\"y\": 2})\n        xr.testing.assert_identical(r.window_labels, da[\"y\"])\n\n    def test_window_labels_uses_first_dim(self, da):\n        r = DataArrayRolling(da, {\"x\": 2, \"y\": 2})\n        xr.testing.assert_identical(r.window_labels, da[\"x\"])\n\n    def test_window_labels_without_coordinate(self):\n        arr = xr.DataArray(np.arange(5.0), dims=\"t\")\n        r = DataArrayRolling(arr, {\"t\": 2})\n        np.testing.assert_array_equal(r.window_labels.values, np.arange(5))\n\n    def test_missing_dim_raises(self, da):\n        with pytest.raises(KeyError):\n            DataArrayRolling(da, {\"z\": 2})\n\n    def test_matches_dataarray_rolling(self, da):\n        r = da.rolling(y=3, center=True, min_periods=2)\n        assert isinstance(r, DataArrayRolling)\n        assert r.dim == [\"y\"]\n        assert r.window == [3]\n        assert r.center == [True]\n        assert r.min_periods == 2\n\n    def test_constructed_object_is_usable(self, da):\n        r = DataArrayRolling(da, {\"y\": 2}, min_periods=1)\n        expected = da.rolling(y=2, min_periods=1).sum()\n        xr.testing.assert_identical(r.sum(), expected)\n\n\nclass TestDatasetRollingInit:\n    def test_basic_attributes(self, ds):\n        r = DatasetRolling(ds, {\"y\": 2})\n        assert r.obj is ds\n        assert r.dim == [\"y\"]\n        assert r.window == [2]\n        assert r.center == [False]\n        assert r.min_periods == 2\n\n    def test_rollings_only_for_dependent_vars(self, ds):\n        r = DatasetRolling(ds, {\"y\": 2})\n        assert set(r.rollings) == {\"a\", \"b\"}\n        for key, sub in r.rollings.items():\n            assert isinstance(sub, DataArrayRolling)\n            xr.testing.assert_identical(sub.obj, ds[key])\n            assert sub.dim == [\"y\"]\n            assert sub.window == [2]\n\n    def test_rollings_multi_dim_subsets(self, ds):\n        r = DatasetRolling(ds, {\"x\": 2, \"y\": 3}, center={\"x\": True})\n        assert set(r.rollings) == {\"a\", \"b\", \"c\"}\n        assert r.min_periods == 6\n\n        a = r.rollings[\"a\"]\n        assert a.dim == [\"x\", \"y\"]\n        assert a.window == [2, 3]\n        assert a.center == [True, False]\n        assert a.min_periods == 6\n\n        b = r.rollings[\"b\"]\n        assert b.dim == [\"y\"]\n        assert b.window == [3]\n        assert b.center == [False]\n        # min_periods=None is forwarded, so each sub-rolling uses its own window\n        assert b.min_periods == 3\n\n        c = r.rollings[\"c\"]\n        assert c.dim == [\"x\"]\n        assert c.window == [2]\n        assert c.center == [True]\n        assert c.min_periods == 2\n\n    def test_explicit_min_periods_forwarded(self, ds):\n        r = DatasetRolling(ds, {\"x\": 2, \"y\": 3}, min_periods=1)\n        assert r.min_periods == 1\n        assert all(sub.min_periods == 1 for sub in r.rollings.values())\n\n    def test_scalar_center_forwarded(self, ds):\n        r = DatasetRolling(ds, {\"x\": 2, \"y\": 2}, center=True)\n        assert r.center == [True, True]\n        assert r.rollings[\"a\"].center == [True, True]\n        assert r.rollings[\"b\"].center == [True]\n        assert r.rollings[\"c\"].center == [True]\n\n    def test_no_dependent_vars(self, ds):\n        r = DatasetRolling(ds[[\"d\"]].assign_coords(x=ds.x), {\"x\": 2})\n        assert r.rollings == {}\n\n    def test_missing_dim_raises(self, ds):\n        with pytest.raises(KeyError):\n            DatasetRolling(ds, {\"q\": 2})\n\n    def test_missing_dim_among_valid_raises(self, ds):\n        with pytest.raises(KeyError):\n            DatasetRolling(ds, {\"x\": 2, \"q\": 2})\n\n    def test_invalid_window(self, ds):\n        with pytest.raises(ValueError, match=\"window must be > 0\"):\n            DatasetRolling(ds, {\"x\": 0})\n\n    def test_invalid_min_periods(self, ds):\n        with pytest.raises(ValueError, match=\"min_periods must be greater than zero\"):\n            DatasetRolling(ds, {\"x\": 2}, min_periods=0)\n\n    def test_matches_dataset_rolling(self, ds):\n        r = ds.rolling(x=2, center=True)\n        assert isinstance(r, DatasetRolling)\n        assert r.dim == [\"x\"]\n        assert r.center == [True]\n        assert set(r.rollings) == {\"a\", \"c\"}\n\n    def test_repr(self, ds):\n        r = DatasetRolling(ds, {\"x\": 2, \"y\": 3}, center={\"x\": True})\n        assert repr(r) == \"DatasetRolling [x->2(center),y->3]\"\n\n\nclass TestCoarsenInit:\n    def test_basic_attributes(self, da):\n        windows = {\"y\": 2}\n        c = DataArrayCoarsen(da, windows, \"exact\", \"left\", \"mean\")\n        assert c.obj is da\n        assert c.windows is windows\n        assert c.boundary == \"exact\"\n        assert c.side == \"left\"\n\n    def test_scalar_coord_func_expanded(self, da):\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"exact\", \"left\", \"sum\")\n        assert c.coord_func[\"x\"] == \"sum\"\n        assert c.coord_func[\"y\"] == \"sum\"\n        # non-dimension coordinates default to mean\n        assert c.coord_func[\"lab\"] is duck_array_ops.mean\n        assert set(c.coord_func) == {\"x\", \"y\", \"lab\"}\n\n    def test_callable_coord_func_expanded(self, da):\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"exact\", \"left\", np.max)\n        assert c.coord_func[\"x\"] is np.max\n        assert c.coord_func[\"y\"] is np.max\n\n    def test_mapping_coord_func_filled_with_mean(self, da):\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"exact\", \"left\", {\"y\": \"max\"})\n        assert c.coord_func[\"y\"] == \"max\"\n        assert c.coord_func[\"x\"] is duck_array_ops.mean\n        assert c.coord_func[\"lab\"] is duck_array_ops.mean\n\n    def test_mapping_coord_func_extra_keys_kept(self, da):\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"exact\", \"left\", {\"other\": \"min\"})\n        assert c.coord_func[\"other\"] == \"min\"\n\n    def test_scalar_coord_func_dims_without_coords(self):\n        arr = xr.DataArray(np.zeros((2, 4)), dims=(\"a\", \"b\"))\n        c = DataArrayCoarsen(arr, {\"b\": 2}, \"exact\", \"left\", \"min\")\n        assert c.coord_func == {\"a\": \"min\", \"b\": \"min\"}\n\n    def test_mapping_side_stored(self, da):\n        side = {\"y\": \"right\"}\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"trim\", side, \"mean\")\n        assert c.side is side\n        assert c.boundary == \"trim\"\n\n    def test_missing_dim_raises(self, da):\n        with pytest.raises(ValueError, match=r\"Dimensions \\['z'\\] not found in DataArray\"):\n            DataArrayCoarsen(da, {\"z\": 2}, \"exact\", \"left\", \"mean\")\n\n    def test_multiple_missing_dims_listed(self, da):\n        with pytest.raises(ValueError, match=r\"\\['z', 'w'\\]\"):\n            DataArrayCoarsen(da, {\"y\": 2, \"z\": 2, \"w\": 3}, \"exact\", \"left\", \"mean\")\n\n    def test_dataset_missing_dim_raises(self, ds):\n        with pytest.raises(ValueError, match=r\"Dimensions \\['q'\\] not found in Dataset\"):\n            DatasetCoarsen(ds, {\"q\": 2}, \"exact\", \"left\", \"mean\")\n\n    def test_dataset_coord_func(self, ds):\n        c = DatasetCoarsen(ds, {\"y\": 2}, \"exact\", \"left\", \"sum\")\n        assert c.coord_func[\"x\"] == \"sum\"\n        assert c.coord_func[\"y\"] == \"sum\"\n        assert c.coord_func[\"z\"] == \"sum\"\n        assert c.coord_func[\"lab\"] is duck_array_ops.mean\n\n    def test_matches_dataarray_coarsen(self, da):\n        c = da.coarsen(y=2, boundary=\"trim\", side=\"right\", coord_func=\"max\")\n        assert isinstance(c, DataArrayCoarsen)\n        assert c.windows == {\"y\": 2}\n        assert c.boundary == \"trim\"\n        assert c.side == \"right\"\n        assert c.coord_func[\"y\"] == \"max\"\n\n    def test_repr(self, da):\n        c = DataArrayCoarsen(da, {\"y\": 2}, \"exact\", \"left\", \"mean\")\n        assert repr(c) == \"DataArrayCoarsen [windows->{'y': 2},side->left]\"\n"
