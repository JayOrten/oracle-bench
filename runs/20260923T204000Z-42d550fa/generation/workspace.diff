+class TestRequestIntegration:
+    def test_request_prepare_with_form_data(self):
+        r = Request('POST', 'http://example.com/', data={'a': 'b'}).prepare()
+        assert r.body == 'a=b'
+        assert r.headers['Content-Type'] == 'application/x-www-form-urlencoded'
+        assert r.headers['Content-Length'] == '3'
+
+    def test_request_prepare_with_files(self):
+        r = Request(
+            'POST', 'http://example.com/',
+            files={'file': ('test.txt', b'content')}
+        ).prepare()
+        boundary = multipart_boundary(r.headers['Content-Type'])
+        assert isinstance(r.body, bytes)
+        assert r.body.startswith(('--%s\r\n' % boundary).encode('utf-8'))
+        assert r.body.endswith(('--%s--\r\n' % boundary).encode('utf-8'))
+        assert r.headers['Content-Length'] == str(len(r.body))
+
+    def test_request_prepare_stream_and_files_conflict(self):
+        req = Request('POST', 'http://example.com/',
+                      data=(i for i in range(2)),
+                      files={'file': ('a.txt', b'A')})
+        with pytest.raises(NotImplementedError):
+            req.prepare()
+
+    def test_request_prepare_without_data(self):
+        r = Request('GET', 'http://example.com/').prepare()
+        assert r.body is None
+        assert r.headers['Content-Length'] == '0'
