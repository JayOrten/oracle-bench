th(__file__).resolve().parents[1]\nREPO_SRC = REPO_ROOT / \"src\"\nTARGET_FILE = REPO_SRC / \"_pytest\" / \"logging.py\"\n\n\ndef _repo_pytest_version() -> str:\n    namespace = {}\n    version_file = REPO_SRC / \"_pytest\" / \"_version.py\"\n    code = compile(version_file.read_text(encoding=\"utf-8\"), str(version_file), \"exec\")\n    exec(code, namespace)\n    return str(namespace[\"version\"])\n\n\ndef _child_env() -> dict:\n    env = os.environ.copy()\n    env[\"PYTHONPATH\"] = os.pathsep.join(\n        filter(None, [str(REPO_SRC), env.get(\"PYTHONPATH\", \"\")])\n    )\n    env.pop(\"PYTEST_ADDOPTS\", None)\n    return env\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef repo_logging_module_is_importable(tmp_path_factory) -> None:\n    assert TARGET_FILE.is_file(), f\"repo source not found: {TARGET_FILE}\"\n    workdir = tmp_path_factory.mktemp(\"repo-import-check\")\n    proc = subprocess.run(\n        [sys.executable, \"-c\", \"import _pytest.logging as m; print(m.__file__)\"],\n        capture_output=True,\n        text=True,\n        cwd=str(workdir),\n        env=_child_env(),\n    )\n    assert proc.returncode == 0, proc.stderr\n    assert proc.stdout.strip() == str(TARGET_FILE), proc.stdout\n```\n\nWait, session fixture with tmp_path_factory — that's allowed. Or use tempfile. tmp_path_factory is fine.\n\n```python\n@pytest.fixture\ndef run_repo_python(tmp_path):\n    def run(code: str) -> str:\n        prelude = (\n            \"import _pytest.logging as _m\\n\"\n            f\"assert _m.__file__ == {str(TARGET_FILE)!r}, _m.__file__\\n\"\n        )\n        proc = subprocess.run(\n            [sys.executable, \"-c\", prelude + textwrap.dedent(code)],\n            capture_output=True,\n            text=True,\n            cwd=str(tmp_path),\n            env=_child_env(),\n        )\n        assert proc.returncode == 0, (\n            f\"child process failed (rc={proc.returncode})\\n\"\n            f\"--- stdout ---\\n{proc.stdout}\\n--- stderr 